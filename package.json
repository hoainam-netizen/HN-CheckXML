{
  "name": "matdash-react-vite-ts",
  "homepage": "https://themewagon.github.io/MatDash/",
  "private": true,
  "version": "1.0.4",
  "description": "Ứng dụng check XML desktop",
  "author": "Nguyễn Quang Hoài Nam",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:react": "vite build",
    "dist": "npm run build:react && electron-builder --win --x64",
    "build": "npm run build:react && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@supabase/supabase-js": "^2.10.0",
    "@svgr/rollup": "8.1.0",
    "@tabler/icons-react": "^2.39.0",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^5.25.1",
    "axios": "^1.10.0",
    "dayjs": "^1.11.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "flowbite": "^2.5.2",
    "flowbite-react": "^0.10.2",
    "lodash": "^4.17.21",
    "lucide-react": "^1.14.0",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^9.3.2",
    "node-machine-id": "^1.1.12",
    "pako": "^2.1.0",
    "pkcs11js": "^2.1.6",
    "react": "^19.0.0",
    "react-activation": "^0.13.4",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "react-toastify": "^11.0.5",
    "simplebar-react": "^3.2.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@iconify/react": "^5.1.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "20.10.5",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "latest",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.checkXML.app",
    "productName": "HN-CheckXML",
    "files": [
      "dist/**/*",
      "main/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hoainam-netizen",
        "repo": "HN-CheckXML"
      }
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ""
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
